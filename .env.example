# Postgres connection string (Neon pooled URL on Vercel). Never commit real values.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional on Vercel: defaults to the production domain (or the branch domain on previews).
APP_ORIGIN=https://pipeline.example.com
# Generate a random secret (at least 32 characters) and keep it stable.
LINK_SECRET=
# Vercel Cron sends this as a bearer token to /api/cron/cleanup.
CRON_SECRET=
WORKSPACE_TIME_ZONE=America/New_York
# First admin on hosts without a shell. Remove after the admin has set a password.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_SETUP_TOKEN=   (43 URL-safe characters; the setup link is /setup/<token>)
# Local server only
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Optional read-only remote MCP sign-in via your OAuth provider.
# MCP_ISSUER=https://identity.example.com
# MCP_INTROSPECTION_URL=https://identity.example.com/oauth/introspect
# MCP_INTROSPECTION_CLIENT_ID=
# MCP_INTROSPECTION_CLIENT_SECRET=
# MCP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com
