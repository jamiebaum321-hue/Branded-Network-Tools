{
  "name": "branded-network-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "admin:create": "node --env-file-if-exists=.env server/cli.mjs bootstrap",
    "db:backup": "node --env-file-if-exists=.env server/cli.mjs backup",
    "test": "node --test"
  }
}
